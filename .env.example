DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opsscheduler?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_EMAIL_FROM="OpsScheduler <no-reply@example.com>"
AUTH_ALLOWED_EMAILS="ops.user@example.com,ops.admin@example.com"
AUTH_MAGIC_LINK_MAX_AGE_SECONDS="900"
AUTH_SESSION_MAX_AGE_SECONDS="1209600"
AUTH_SESSION_UPDATE_AGE_SECONDS="43200"
AUTH_SIGNIN_RATE_LIMIT_REQUESTS="10"
AUTH_SIGNIN_RATE_LIMIT_WINDOW_SECONDS="60"
# Optional local development bypass. Keep "off" for normal auth.
# Allowed values: off, admin, user. Never enable in production.
AUTH_DEV_BYPASS_MODE="off"
# Optional explicit dev user selectors used when bypass is enabled.
AUTH_DEV_BYPASS_ADMIN_EMAIL=""
AUTH_DEV_BYPASS_USER_EMAIL=""
SEED_ORGANIZATION_NAME="OpsScheduler"
SEED_ADMIN_EMAIL="ops.admin@example.com"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
