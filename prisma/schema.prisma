generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user
}

model Organization {
  id           String     @id @default(cuid())
  name         String     @unique
  defaultColour String    @default("#2563eb") @map("default_colour")
  users        User[]
  workItems    WorkItem[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
}

model User {
  id                       String       @id @default(cuid())
  name                     String
  email                    String       @unique
  emailVerified            DateTime?
  image                    String?      @map("profile_image_url")
  dateLocale               String       @default("en-GB") @map("date_locale") @db.VarChar(10)
  uiTheme                  String       @default("light") @map("ui_theme") @db.VarChar(16)
  timezone                 String?
  calendarVisibleStartTime String       @default("08:00:00") @map("calendar_visible_start_time") @db.VarChar(8)
  calendarVisibleEndTime   String       @default("20:00:00") @map("calendar_visible_end_time") @db.VarChar(8)
  colour                   String       @unique
  role                     UserRole     @default(user)
  active                   Boolean      @default(true)
  organizationId           String       @map("organization_id")
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accounts                 Account[]
  sessions                 Session[]
  assignedWorkItems        WorkItem[]   @relation("WorkItemAssignee")
  createdWorkItems         WorkItem[]   @relation("WorkItemCreatedBy")
  updatedWorkItems         WorkItem[]   @relation("WorkItemUpdatedBy")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model WorkItem {
  id             String       @id @default(cuid())
  title          String
  customer       String?
  notes          String?
  assigneeId     String?      @map("assignee_id")
  assignee       User?        @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetWeek     DateTime     @map("target_week") @db.Date
  startDate      DateTime?    @map("start_date") @db.Date
  endDate        DateTime?    @map("end_date") @db.Date
  startTime      DateTime?    @map("start_time") @db.Time(6)
  endTime        DateTime?    @map("end_time") @db.Time(6)
  fixed          Boolean      @default(false)
  onHold         Boolean      @default(false) @map("on_hold")
  cancelled      Boolean      @default(false)
  done           Boolean      @default(false)
  createdById    String       @map("created_by")
  createdBy      User         @relation("WorkItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById    String       @map("updated_by")
  updatedBy      User         @relation("WorkItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([targetWeek])
  @@index([startDate])
  @@index([assigneeId])
  @@index([done])
  @@index([cancelled])
  @@index([onHold])
  @@index([fixed])
}

model RateLimitBucket {
  key         String   @map("key")
  windowStart DateTime @map("window_start")
  count       Int
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([key, windowStart])
  @@index([expiresAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  occurredAt     DateTime @default(now()) @map("occurred_at")
  action         String   @db.VarChar(120)
  outcome        String   @db.VarChar(16)
  actorUserId    String?  @map("actor_user_id")
  organizationId String?  @map("organization_id")
  targetType     String?  @map("target_type") @db.VarChar(64)
  targetId       String?  @map("target_id")
  metadata       Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([occurredAt])
  @@index([organizationId, occurredAt])
  @@index([action, occurredAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
